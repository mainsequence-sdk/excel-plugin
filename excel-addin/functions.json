{
  "namespace": "CUSTOMFUNCTIONS",
  "properties": { "allowCustomDataForDataTypeAny": true },
  "functions": [
    {
      "name": "SET_BASE_ROOT",
      "description": "Stores the API base URL for this add-in.",
      "parameters": [
        { "name": "url", "description": "Base API root", "type": "string" }
      ],
      "id": "SET_BASE_ROOT",
      "result": { "type": "string", "dimensionality": "scalar" }
    },
    {
      "name": "GET_DATA_BETWEEN_DATES_FROM_API",
      "description": "Fetch rows between dates and spill as a table.",
      "parameters": [
        { "name": "table_name", "type": "string" },
        { "name": "start_date", "type": "any", "optional": true },
        { "name": "end_date", "type": "any", "optional": true },
        { "name": "great_or_equal", "type": "any", "optional": true },
        { "name": "less_or_equal", "type": "any", "optional": true },
        { "name": "columns", "type": "any", "optional": true, "dimensionality": "matrix" },
        { "name": "unique_identifier_list", "type": "any", "optional": true, "dimensionality": "matrix" }
      ],
      "id": "GET_DATA_BETWEEN_DATES_FROM_API",
      "result": { "type": "any", "dimensionality": "matrix" }
    }
  ]
}
